# versions.env — central place to pin tool versions. Edit before running install.

# Java (SDKMAN! identifiers)
JAVA_VERSION="21.0.5-tem"
MAVEN_VERSION="3.9.9"
GRADLE_VERSION="8.10.2"

# Node (nvm)
NODE_VERSION="--lts"

# Python (pyenv)
PYTHON_VERSION="3.12"

# .NET (dotnet-install.sh)
DOTNET_CHANNEL="LTS"

# Go
GO_VERSION="1.23.2"

# lazydocker
LAZYDOCKER_VERSION="0.24.1"
